<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX manifest for the Microsoft Store build. packaging/build.py fills in
     the version; the identity comes from Partner Center (Product identity).
     The StartupTask id must match STARTUP_TASK_ID in platforms/windows.py. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="dpsk.MuseumWallpapers"
    Publisher="CN=11410CB1-4E3D-406F-8EAE-2D56EEB598E5"
    Version="{VERSION}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Museum Wallpapers</DisplayName>
    <PublisherDisplayName>dpsk</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Endless public-domain paintings from museums worldwide as your wallpaper.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ru-ru" />
    <Resource Language="uk-ua" />
    <Resource Language="de-de" />
    <Resource Language="fr-fr" />
    <Resource Language="es-es" />
    <Resource Language="it-it" />
    <Resource Language="nl-nl" />
    <Resource Language="pl-pl" />
    <Resource Language="pt-br" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="MuseumWallpapers.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Museum Wallpapers"
        Description="Endless public-domain paintings from museums worldwide as your wallpaper, with the title, artist and story one click away."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="MuseumWallpapers.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="MuseumWallpapersStartup" Enabled="true" DisplayName="Museum Wallpapers" />
        </desktop:Extension>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="MuseumWallpapers.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="museum-wallpapers.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
